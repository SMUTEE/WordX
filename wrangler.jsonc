{
  // WordX on Cloudflare: the app as static assets, the API in a Worker, one Durable Object per friends game.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordx",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      { "name": "PROFILES", "class_name": "ProfileObject" },
      { "name": "USERNAMES", "class_name": "UsernameObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomObject"] },
    { "tag": "v2", "new_sqlite_classes": ["ProfileObject"] },
    { "tag": "v3", "new_sqlite_classes": ["UsernameObject"] }
  ],
  // Anonymous usage events for the private stats page (/admin).
  "d1_databases": [{ "binding": "STATS", "database_name": "wordx-stats", "database_id": "17485e0f-7657-433d-b9eb-8ae9806dc91e", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
