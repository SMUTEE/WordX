{
  "name": "daily-wordx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,blue \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "dict": "node scripts/build-dictionary.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "record": "npm run build && tsx scripts/record.ts"
  },
  "dependencies": {
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "an-array-of-english-words": "^2.0.0",
    "concurrently": "^10.0.5",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wordlist-english": "^1.2.1",
    "wrangler": "^4.147.0"
  }
}
